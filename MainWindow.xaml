<Window x:Class="Passwortspeicher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Passwortspeicher.ViewModels"
        Title="Passwort-Speicher" Height="680" Width="850" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="15">
        <!-- 1. Login-Bereich -->
        <StackPanel Visibility="{Binding IsLoggedOut, Converter={StaticResource BoolToVis}}" 
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
            <TextBlock Text="Passwort-Manager Login" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <TextBlock Text="Benutzername:"/>
            <TextBox Text="{Binding InputBenutzername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="25" VerticalContentAlignment="Center"/>

            <TextBlock Text="Passwort:"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="LoginPasswordBox" Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                             Visibility="{Binding IsLoginPasswordVisible, Converter={StaticResource BoolToVisInverted}}"
                             PasswordChanged="LoginPasswordBox_PasswordChanged"/>

                <TextBox Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                         Visibility="{Binding IsLoginPasswordVisible, Converter={StaticResource BoolToVis}}"
                         Text="{Binding InputPasswort, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="1" Command="{Binding ToggleLoginPasswordVisibilityCommand}" 
                        Content="👁" Width="30" Height="25" Margin="5,0,0,0" ToolTip="Passwort anzeigen/verbergen"/>
            </Grid>

            <Button Content="Anmelden" Command="{Binding LoginCommand}" Height="30" Margin="0,0,0,15" FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Noch kein Konto? " Foreground="Gray" VerticalAlignment="Center"/>
                <Button Content="Hier Registrieren" Command="{Binding OpenRegisterWindowCommand}" 
                        Background="Transparent" BorderThickness="0"
                        Foreground="#0066CC" Cursor="Hand" Padding="2,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 2. Hauptansicht nach Login -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Suche & Abmelden -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Suche (Website / Benutzer):" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <TextBox Grid.Column="1" Text="{Binding SuchText, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>

                <!-- Abmelden Button führt jetzt zusätzlich den Clear im UI aus -->
                <Button Grid.Column="2" Content="Abmelden" Command="{Binding LogoutCommand}" Click="LogoutButton_Click" Margin="15,0,0,0" Width="90" Height="25"/>
            </Grid>

            <!-- DataGrid Tabelle -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Eintraege}" SelectedItem="{Binding SelectedEintrag}" 
                      AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Website / Programm *" Binding="{Binding WebsiteOderProgramm}" Width="2*"/>
                    <DataGridTextColumn Header="Benutzername *" Binding="{Binding Benutzername}" Width="2*"/>
                    <DataGridTextColumn Header="Passwort *" Binding="{Binding Passwort}" Width="1.5*"/>
                    <DataGridTextColumn Header="Bemerkung 1" Binding="{Binding Bemerkung1}" Width="2*"/>
                    <DataGridTextColumn Header="Bemerkung 2" Binding="{Binding Bemerkung2}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Details / Formular unten -->
            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Eintrag Details / Bearbeiten" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Website / Programm -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,5">
                            <TextBlock Text="Website / Programm *:"/>
                            <TextBox Text="{Binding NeuWebsiteOderProgramm, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Benutzername -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,5">
                            <TextBlock Text="Benutzername *:"/>
                            <TextBox Text="{Binding NeuBenutzername, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Passwort -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,5,5">
                            <TextBlock Text="Passwort *:"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NeuPasswort, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="Generieren" Command="{Binding GeneratePasswordCommand}" Margin="5,0,0,0" Padding="8,0"/>
                            </Grid>
                        </StackPanel>

                        <!-- Bemerkung 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,5">
                            <TextBlock Text="Bemerkung 1:"/>
                            <TextBox Text="{Binding NeuBemerkung1, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Bemerkung 2 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBlock Text="Bemerkung 2:"/>
                            <TextBox Text="{Binding NeuBemerkung2, UpdateSourceTrigger=PropertyChanged}" Height="25" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Aktionsbuttons -->
                    <Grid Margin="0,5,0,0">
                        <Button Content="Login-Passwort ändern" Command="{Binding OpenChangePasswordWindowCommand}" 
                                HorizontalAlignment="Left" Padding="10,5"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Neuer Eintrag (Formular leeren)" Command="{Binding NewEintragCommand}" Margin="0,0,10,0" Padding="10,5"/>
                            <Button Content="Speichern / Ändern" Command="{Binding SaveEintragCommand}" Margin="0,0,10,0" Padding="10,5" FontWeight="Bold"/>
                            <Button Content="Eintrag Löschen" Command="{Binding DeleteEintragCommand}" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>