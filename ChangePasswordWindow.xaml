<Window x:Class="Passwortspeicher.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master-Passwort ändern" Height="380" Width="400" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" Width="300">
            <TextBlock Text="Master-Passwort ändern" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <!-- Altes Passwort -->
            <TextBlock Text="Altes Passwort:"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="OldPasswordBox" Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                             Visibility="{Binding IsOldPasswordVisible, Converter={StaticResource BoolToVisInverted}}"
                             PasswordChanged="OldPasswordBox_PasswordChanged"
                             IsVisibleChanged="OldPasswordBox_IsVisibleChanged"/>
                <TextBox Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                         Visibility="{Binding IsOldPasswordVisible, Converter={StaticResource BoolToVis}}"
                         Text="{Binding OldPasswort, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Command="{Binding ToggleOldPasswordVisibilityCommand}" Content="👁" Width="30" Height="25" Margin="5,0,0,0"/>
            </Grid>

            <!-- Neues Passwort -->
            <TextBlock Text="Neues Passwort:"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="NewPasswordBox" Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                             Visibility="{Binding IsNewPasswordVisible, Converter={StaticResource BoolToVisInverted}}"
                             PasswordChanged="NewPasswordBox_PasswordChanged"
                             IsVisibleChanged="NewPasswordBox_IsVisibleChanged"/>
                <TextBox Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                         Visibility="{Binding IsNewPasswordVisible, Converter={StaticResource BoolToVis}}"
                         Text="{Binding NewPasswort, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Command="{Binding ToggleNewPasswordVisibilityCommand}" Content="👁" Width="30" Height="25" Margin="5,0,0,0"/>
            </Grid>

            <!-- Neues Passwort wiederholen -->
            <TextBlock Text="Neues Passwort wiederholen:"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="NewPasswordWdhBox" Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                             Visibility="{Binding IsNewPasswordWdhVisible, Converter={StaticResource BoolToVisInverted}}"
                             PasswordChanged="NewPasswordWdhBox_PasswordChanged"
                             IsVisibleChanged="NewPasswordWdhBox_IsVisibleChanged"/>
                <TextBox Grid.Column="0" Height="25" VerticalContentAlignment="Center"
                         Visibility="{Binding IsNewPasswordWdhVisible, Converter={StaticResource BoolToVis}}"
                         Text="{Binding NewPasswortWdh, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Command="{Binding ToggleNewPasswordWdhVisibilityCommand}" Content="👁" Width="30" Height="25" Margin="5,0,0,0"/>
            </Grid>

            <Button Content="Passwort ändern" Command="{Binding ExecuteChangePasswordCommand}" Height="30" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Content="Abbrechen" Command="{Binding CloseChangePasswordWindowCommand}" Height="25"/>
        </StackPanel>
    </Grid>
</Window>